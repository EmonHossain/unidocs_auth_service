# Auth-specific settings and credentials; shared connections are in ../.env.
# Run scripts/prepare-local.ps1; use the integrated ../docker-compose.yaml.
# Local development passwords are explicit; blank crypto credentials are generated.
ACCOUNT_NOTICE_SMTP_ENABLED=true
ACCOUNT_NOTICE_SMTP_FROM=no-reply@unidocs.local
ACCOUNT_RETENTION_MONTHS=3
AUDIT_OUTBOX_TOPIC=iam.security-audit.v1
AUTHORIZATION_CACHE_ENABLED=true
AUTHORIZATION_CACHE_LISTENER_ENABLED=true
AUTH_BROWSER_REFRESH_ALLOWED_ORIGINS=
AUTH_INFRASTRUCTURE_ENABLED=true
AUTH_METRICS_SCRAPE_TOKEN=
AUTH_OTLP_TRACING_ENABLED=false
AUTH_TEST_DB_PASSWORD=admin123
AUTH_TEST_DB_NAME=auth_service_test
AUTH_TEST_DB_URL_OPTIONS=connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
AUTH_TEST_DB_USERNAME=auth_service_test
AUTH_TRACING_SAMPLING_PROBABILITY=1.0
CAFFEINE_SPEC=maximumSize=10000,expireAfterWrite=30s,recordStats
DB_NAME=auth_service
DB_URL_OPTIONS=connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=admin
INTERNAL_AUTHORIZATION_AUDIENCE=urn:unidocs:iam-internal
INTERNAL_AUTHORIZATION_ENABLED=true
INTERNAL_AUTHORIZATION_ISSUER=https://localhost:8443/realms/unidocs-services
INTERNAL_AUTHORIZATION_SERVICE_SUBJECTS=document-service
JWT_ACTIVE_KID=local-docker-key
JWT_AUDIENCE=urn:unidocs:drive
JWT_ISSUER=urn:unidocs:auth
JWT_PRIVATE_KEY=file:/run/secrets/application/auth-private.pem
JWT_PUBLIC_KEY=file:/run/secrets/application/auth-public.pem
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KEYCLOAK_DOCUMENT_CLIENT_SECRET=
KEYCLOAK_TRUSTSTORE_PASSWORD=changeit
LOGIN_ATTACK_PROTECTION_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db,redis,kafka
ORGANIZATION_INVITATION_SMTP_ENABLED=true
ORGANIZATION_INVITATION_SMTP_FROM=no-reply@unidocs.local
OUTBOX_ENABLED=true
PASSWORD_RECOVERY_EMAIL_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REGISTRATION_SMTP_ENABLED=true
REGISTRATION_SMTP_FROM=no-reply@unidocs.local
SMTP_AUTH_ENABLED=false
SMTP_HOST=mailpit
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false
SMTP_USERNAME=
SPRING_MAIL_PORT=1025
SPRING_PROFILES_ACTIVE=metrics
STUDENT_STORAGE_CREATE_BUCKET=true
STUDENT_STORAGE_ENABLED=true
TESTCONTAINERS_REUSE_ENABLE=true
TESTCONTAINERS_RYUK_DISABLED=true


DB_PASSWORD=admin123
OUTBOX_TOPIC=iam.domain-events.v1
STUDENT_STORAGE_ACCESS_KEY=admin
STUDENT_STORAGE_SECRET_KEY=admin1234

# Local Swagger UI; disable in production.
AUTH_API_DOCS_ENABLED=true

# Generated by scripts/prepare-local.ps1 -LocalProduction; Auth-owned TLS only.
AUTH_TLS_STORE_PASSWORD=<generated-local-tls-password>

AUTH_TEST_REDIS_DATABASE=1
AUTH_TEST_JWT_ISSUER=urn:unidocs:auth:test
AUTH_TEST_JWT_AUDIENCE=urn:unidocs:drive:test
AUTH_TEST_OUTBOX_TOPIC=iam.test.domain-events.v1
AUTH_TEST_AUDIT_OUTBOX_TOPIC=iam.test.security-audit.v1
AUTH_TEST_STUDENT_STORAGE_BUCKET=student-evidence-test
# Required external SMTP for local production mode; preserve existing private values.
AUTH_PROD_SMTP_HOST=
AUTH_PROD_SMTP_PORT=587
AUTH_PROD_SMTP_USERNAME=
AUTH_PROD_SMTP_PASSWORD=
